{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "listingflow-x",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  // 사이트 공개 여부. "true" 로 바꾸고 배포하면 공개된다.
  "vars": {
    "SITE_PUBLIC": "false"
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "listingflowx.com", "custom_domain": true },
    { "pattern": "www.listingflowx.com", "custom_domain": true },
    { "pattern": "listingflow-x.com", "custom_domain": true },
    { "pattern": "www.listingflow-x.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
